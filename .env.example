# Aimlake Open Telematics — self-hosted example
# Copy to .env and set secrets before `docker compose up -d`

POSTGRES_USER=aimlake
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aimlake_telematics
DATABASE_URL=postgresql://aimlake:change-me@postgres:5432/aimlake_telematics

VALKEY_URL=redis://valkey:6379/0

# Generate strong values for production (wizard will help)
APP_SECRET_KEY=change-me-generate-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Optional: leave empty for defaults (no commercial cloud required)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAP_TILE_URL=

# Privacy: installation analytics off unless explicitly opted in
TELEMETRY_OPT_IN=false
